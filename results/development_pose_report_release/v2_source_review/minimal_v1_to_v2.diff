+def _atom_order_permutation(actual_names, canonical_names):
+    """Require a complete named full-parent bijection, never a scored-core mask."""
+    for names in (actual_names, canonical_names):
+        if (not isinstance(names, list) or not names
+                or any(not isinstance(name, str) or not name for name in names)
+                or len(names) != len(set(names))):
+            raise ValueError("Atom order requires nonempty unique string name lists")
+    if len(actual_names) != len(canonical_names) or set(actual_names) != set(canonical_names):
+        raise ValueError("Box and canonical full-parent atom names are not a complete bijection")
+    actual_index = {name: index for index, name in enumerate(actual_names)}
+    return [actual_index[name] for name in canonical_names]
+
+
+def canonicalize_pooled_poses(rows, boxes, canonical_names):
+    """Permute raw named rows into parent order without changing coordinates/ranks."""
+    by_box = {box["id"]: box for box in boxes}
+    if len(by_box) != len(boxes):
+        raise ValueError("Duplicate source box identity for atom-order correction")
+    corrected = []
+    for row in rows:
+        if row.get("box_id") not in by_box:
+            raise ValueError("Pooled pose refers to an unknown source box")
+        box = by_box[row["box_id"]]
+        permutation = _atom_order_permutation(box.get("names"), canonical_names)
+        try:
+            xyz = np.asarray(row["coordinates"])
+        except (TypeError, ValueError) as error:
+            raise ValueError("Raw full-parent coordinates must be a finite numeric Nx3 array") from error
+        if (xyz.dtype.kind not in "fiu" or xyz.shape != (len(permutation), 3)
+                or not np.isfinite(xyz).all()):
+            raise ValueError("Raw full-parent coordinates must be a finite numeric Nx3 array")
+        coordinates = xyz[permutation].copy()
+        if not np.array_equal(coordinates[np.argsort(permutation)], xyz):
+            raise ValueError("Atom-order correction changed coordinate values")
+        corrected.append({**row, "coordinates": coordinates})
+    return corrected
+
+
+def _atom_order_reference(evidence, directory, reference_raw):
+    manifest = evidence.json(Path(directory) / "inputs/manifest.json")
+    entries = [entry for entry in manifest["files"] if entry["filename"] == "reference.json"]
+    if len(entries) != 1 or hashlib.sha256(reference_raw).hexdigest() != entries[0]["sha256"]:
+        raise ValueError("Atom-order reference is not bound to its archived bytes")
+    entry = entries[0]
+    return {"archive": (Path(directory) / "inputs" / entry["archive"]).as_posix(),
+            "archive_sha256": entry["archive_sha256"], "reference_sha256": entry["sha256"]}
+
+
+def _geometry_baseline(evidence, directory, sdf):
+    manifest = evidence.json(Path(directory) / "inputs/manifest.json")
+    entries = [entry for entry in manifest["files"] if entry["filename"] == "ligand.sdf"]
+    if len(entries) != 1 or hashlib.sha256(sdf).hexdigest() != entries[0]["sha256"]:
+        raise ValueError("Legacy geometry baseline is not bound to its archived SDF")
+    entry = entries[0]
+    return {"source": "archived_independent_legacy_SDF",
+            "archive": (Path(directory) / "inputs" / entry["archive"]).as_posix(),
+            "archive_sha256": entry["archive_sha256"], "uncompressed_sha256": entry["sha256"],
+            "exact_executed_box_PDBQT_baseline": False,
+            "coordinate_lineage": "same independent initializer; SDF coordinates precede PDBQT and box-translation coordinate rounding",
+            "applies_to_fields": ["max_heavy_bond_length_change_from_input_A",
+                                  "max_ring_pair_distance_change_from_input_A",
+                                  "glycosidic_links[].input_distance_A"]}
+
+
+def _atom_order_provenance(boxes, canonical_names, canonical_reference, geometry_baseline=None):
+    return [{"box_id": box["id"], "raw_box_names": list(box["names"]),
+             "canonical_parent_names": list(canonical_names),
+             "canonical_to_raw_indices": _atom_order_permutation(box["names"], canonical_names),
+             "raw_reference": box["atom_order_reference"], "canonical_reference": canonical_reference,
+             "geometry_diagnostic_baseline": geometry_baseline,
+             "operation": "coordinate-row permutation only; no coordinate arithmetic, loss or duplication"}
+            for box in boxes if "names" in box]
+

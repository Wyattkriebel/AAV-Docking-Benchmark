+                "evaluator_sha256": sha256(Path(__file__)),
+                "superseded_evaluator_sha256": _V1_EVALUATOR_SHA256,
+                "correction": "bijective_atom_name_coordinate_permutation",
+                "outcome_timing": "after_invalid_v1_and_corrected_diagnostic_outcomes",
+                "invalid_v1_outcomes_consulted": True, "corrected_diagnostic_outcomes_consulted": True,
+                "configuration_sha256": freeze["configuration_sha256"],
+                "atomic_reference_ledger_sha256": freeze["atomic_reference_ledger_sha256"]}
+    if any(type(amendment.get(key)) is not type(value) or amendment[key] != value
+           for key, value in required.items()):
+        raise ValueError("V2 amendment must bind this evaluator and disclose post-outcome correction timing")
+    return {"path": Path(relative).as_posix(), "sha256": expected, "record": amendment}
+
